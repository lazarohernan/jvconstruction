---
import { MessageCircle, Eye, ShieldCheck } from 'lucide-astro';
---
<section class="section features panel" id="why-us">
    <div class="features__bg" style="background-image: url('/img2/kitchen 1.jpeg')"></div>
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">The J <span class="amp">&amp;</span> V Difference</h2>
            <p class="section-description">Experience quality craftsmanship with a team that puts your vision first.</p>
        </div>
        <div class="features__grid">
            <article class="feature-item">
                <div class="feature-item__icon">
                    <MessageCircle />
                </div>
                <div class="feature-item__content">
                    <h3 class="feature-item__title">Clear Communication</h3>
                    <p class="feature-item__text">Satisfaction starts with clear communication. We keep you informed every step of the way.</p>
                </div>
            </article>
            <article class="feature-item">
                <div class="feature-item__icon">
                    <Eye />
                </div>
                <div class="feature-item__content">
                    <h3 class="feature-item__title">Transparency</h3>
                    <p class="feature-item__text">No hidden fees, no surprises. Just honest, upfront pricing and project management.</p>
                </div>
            </article>
            <article class="feature-item">
                <div class="feature-item__icon">
                    <ShieldCheck />
                </div>
                <div class="feature-item__content">
                    <h3 class="feature-item__title">Warrantied Work</h3>
                    <p class="feature-item__text">We stand behind our workmanship with a 1-Year warranty for your peace of mind.</p>
                </div>
            </article>
        </div>
    </div>
</section>
