---
---
<section class="hero" id="home">
    <div class="hero__image hero__image--bottom">
        <img src="/img/hero2.jpg?v=2" alt="Construction project">
    </div>
    <div class="hero__image hero__image--top">
        <img src="/img/hero.jpg?v=2" alt="Construction work">
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
        <div class="hero__text hero__text--initial">
            <h1 class="hero__title-large">Transforming Spaces</h1>
            <p class="hero__subtitle-large">Where Vision Meets Craftsmanship</p>
        </div>
        <div class="hero__text hero__text--secondary">
            <p class="hero__tagline">Building Dreams Since 2020</p>
            <h2 class="hero__title">
                <span class="hero__title-word">Building</span>
                <span class="hero__title-word">with</span>
                <span class="hero__title-word">Excellence</span>
            </h2>
            <p class="hero__subtitle">Experience the whole journey from planning, design, estimating, project management, and a warranty service like no other.</p>
        </div>
        <div class="hero__cta-container">
            <div class="hero__cta">
                <a href="#contact" class="btn btn--primary">Get a Quote</a>
                <a href="#services" class="btn btn--secondary">Our Services</a>
            </div>
        </div>
    </div>
    <div class="hero__scroll-indicator">
        <span>Scroll to explore</span>
        <div class="hero__scroll-arrow"></div>
    </div>
</section>
