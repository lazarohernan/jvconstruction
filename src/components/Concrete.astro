---
import { HardHat, Layers, Sparkles, CalendarCheck, Home, ShieldCheck, ArrowRight } from 'lucide-astro';
---
<section class="concrete" id="concrete">
    <div class="concrete__bg" style="background-image: url('/img2/structure 2.jpeg')"></div>

    <!-- Intro que se ve primero -->
    <div class="concrete__intro">
        <div class="concrete__icon"><HardHat /></div>
        <span class="concrete__tag">Our Expertise</span>
        <h2 class="concrete__title">Concrete Work</h2>
        <p class="concrete__text">At J <span class="amp">&amp;</span> V Construction, we specialize in high-quality concrete work for residential and light commercial projects. From site preparation to the final finish, we deliver structurally sound, code-compliant concrete built to last.</p>
    </div>

    <!-- Horizontal Scroll - Todo se mueve de derecha a izquierda -->
    <div class="concrete__horizontal-wrapper">
        <div class="concrete__horizontal-track">
            <!-- Panel 1: Servicios -->
            <div class="concrete__horizontal-panel concrete__horizontal-panel--services">
                <div class="concrete__services">
                    <h3 class="concrete__services-title">Our Concrete Services Include:</h3>
                    <div class="concrete__grid">
                        <article class="concrete__service">
                            <div class="concrete__service-image">
                                <img src="/img/concrete/slabs-pouring.jpg" alt="Concrete Slabs" loading="lazy">
                            </div>
                            <div class="concrete__service-content">
                                <h4 class="concrete__service-title">Concrete Slabs (Pouring <span class="amp">&amp;</span> Finishing)</h4>
                                <p class="concrete__service-text">We install concrete slabs for new construction, additions, garages, sheds, and remodeling projects. Every slab is properly graded, compacted, reinforced, and poured to meet structural requirements and local codes.</p>
                            </div>
                        </article>
                        <article class="concrete__service">
                            <div class="concrete__service-image">
                                <img src="/img/concrete/driveway.jpg" alt="Concrete Driveways" loading="lazy">
                            </div>
                            <div class="concrete__service-content">
                                <h4 class="concrete__service-title">Concrete Driveways</h4>
                                <p class="concrete__service-text">We build durable, clean-finished concrete driveways designed to handle daily vehicle traffic and Tennessee weather conditions. Proper base preparation and reinforcement ensure long-term performance and minimal cracking.</p>
                            </div>
                        </article>
                        <article class="concrete__service">
                            <div class="concrete__service-image">
                                <img src="/img/concrete/footings.jpg" alt="Footings &amp; Foundations" loading="lazy">
                            </div>
                            <div class="concrete__service-content">
                                <h4 class="concrete__service-title">Footings <span class="amp">&amp;</span> Foundations</h4>
                                <p class="concrete__service-text">We pour concrete footings and foundation elements with accurate layout, correct dimensions, and proper reinforcement to provide a solid structural base for framing and load-bearing systems.</p>
                            </div>
                        </article>
                        <article class="concrete__service">
                            <div class="concrete__service-image">
                                <img src="/img/concrete/formwork.jpg" alt="Formwork &amp; Reinforcement" loading="lazy">
                            </div>
                            <div class="concrete__service-content">
                                <h4 class="concrete__service-title">Formwork <span class="amp">&amp;</span> Reinforcement</h4>
                                <p class="concrete__service-text">All projects include professional formwork, rebar or wire mesh installation, and precise elevation control to guarantee strength, consistency, and clean edges.</p>
                            </div>
                        </article>
                        <article class="concrete__service concrete__service--fullwidth">
                            <div class="concrete__service-image">
                                <img src="/img/concrete/repairs.jpg" alt="Concrete Repairs &amp; Re-Pours" loading="lazy">
                            </div>
                            <div class="concrete__service-content">
                                <h4 class="concrete__service-title">Concrete Repairs <span class="amp">&amp;</span> Re-Pours</h4>
                                <p class="concrete__service-text">We handle slab replacements, over-pours, corrections, and structural concrete repairs when existing concrete is damaged, uneven, or out of specification.</p>
                            </div>
                        </article>
                    </div>
                </div>
            </div>

            <!-- Panel 2: Our Commitment -->
            <div class="concrete__horizontal-panel concrete__horizontal-panel--commitment">
                <div class="concrete__commitment-content">
                    <span class="concrete__tag">Our Commitment</span>
                    <h2>Why Choose J <span class="amp">&amp;</span> V Construction</h2>
                    <div class="concrete__commitment-grid">
                        <div class="concrete__commitment-card">
                            <div class="concrete__commitment-icon">
                                <Layers />
                            </div>
                            <h4>Proper Grading</h4>
                            <p>Compaction and reinforcement done right</p>
                        </div>
                        <div class="concrete__commitment-card">
                            <div class="concrete__commitment-icon">
                                <Sparkles />
                            </div>
                            <h4>Clean Finishes</h4>
                            <p>Professional quality every time</p>
                        </div>
                        <div class="concrete__commitment-card">
                            <div class="concrete__commitment-icon">
                                <CalendarCheck />
                            </div>
                            <h4>On Schedule</h4>
                            <p>Timely pours and inspections</p>
                        </div>
                        <div class="concrete__commitment-card">
                            <div class="concrete__commitment-icon">
                                <Home />
                            </div>
                            <h4>Proven Experience</h4>
                            <p>Residential and builder-grade projects</p>
                        </div>
                        <div class="concrete__commitment-card">
                            <div class="concrete__commitment-icon">
                                <ShieldCheck />
                            </div>
                            <h4>Safety First</h4>
                            <p>Detail-driven execution always</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Panel 3: CTA -->
            <div class="concrete__horizontal-panel concrete__horizontal-panel--cta">
                <div class="concrete__horizontal-content concrete__horizontal-content--centered">
                    <h2>Reliable Concrete Solutions You Can Trust</h2>
                    <p>Whether you're a homeowner, builder, or investor, J <span class="amp">&amp;</span> V Construction provides reliable concrete solutions you can trust—from small slabs to full driveways and foundations.</p>
                    <a href="#contact" class="btn btn--primary"><span>Get Started Today</span><ArrowRight /></a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
import '../scripts/concrete.js';
</script>
