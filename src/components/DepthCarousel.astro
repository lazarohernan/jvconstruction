---
interface Item {
    image: string;
    alt?: string;
}

interface Props {
    items: Item[];
    cardWidth?: number;
    cardHeight?: number;
    radius?: number;
    tint?: string;
    depth?: number;
    spread?: number;
    tilt?: number;
    tiltDirection?: 'left' | 'right';
    perspective?: number;
    visibleCards?: number;
    falloff?: number;
    blur?: number;
    duration?: number;
    ease?: string;
    autoplay?: boolean;
    autoplayDelay?: number;
    loop?: boolean;
    showControls?: boolean;
    showIndicators?: boolean;
}

const {
    items,
    cardWidth = 260,
    cardHeight = 380,
    radius = 18,
    tint = '#0A192F',
    depth = 130,
    spread = 40,
    tilt = 18,
    tiltDirection = 'right',
    perspective = 1200,
    visibleCards = 4,
    falloff = 0.2,
    blur = 6,
    duration = 700,
    ease = 'power3.out',
    autoplay = true,
    autoplayDelay = 3200,
    loop = true,
    showControls = true,
    showIndicators = true,
} = Astro.props;
---
<div
    class="depth-carousel"
    style={`--dc-perspective:${perspective}px;`}
    role="group"
    aria-roledescription="carousel"
    aria-label="Project gallery"
    tabindex="0"
    data-card-width={cardWidth}
    data-card-height={cardHeight}
    data-radius={radius}
    data-tint={tint}
    data-depth={depth}
    data-spread={spread}
    data-tilt={tilt}
    data-tilt-direction={tiltDirection}
    data-visible-cards={visibleCards}
    data-falloff={falloff}
    data-blur={blur}
    data-duration={duration}
    data-ease={ease}
    data-autoplay={autoplay ? '1' : '0'}
    data-autoplay-delay={autoplayDelay}
    data-loop={loop ? '1' : '0'}
>
    <div class="depth-carousel__stage">
        {items.map((item, i) => (
            <div
                class="depth-carousel__card"
                style={`width:${cardWidth}px;height:${cardHeight}px;border-radius:${radius}px;`}
                data-index={i}
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${items.length}`}
            >
                <img class="depth-carousel__img" src={item.image} alt={item.alt || ''} draggable="false" />
                <span class="depth-carousel__tint" style={`background:${tint};`}></span>
            </div>
        ))}
    </div>

    {showControls && items.length > 1 && (
        <>
            <button type="button" class="depth-carousel__arrow depth-carousel__arrow--prev" aria-label="Previous slide">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <button type="button" class="depth-carousel__arrow depth-carousel__arrow--next" aria-label="Next slide">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </>
    )}

    {showIndicators && items.length > 1 && (
        <div class="depth-carousel__dots" role="tablist" aria-label="Slides">
            {items.map((_, i) => (
                <button type="button" role="tab" aria-label={`Go to slide ${i + 1}`} class={`depth-carousel__dot${i === 0 ? ' is-active' : ''}`} data-index={i}></button>
            ))}
        </div>
    )}
</div>

<script>
import '../scripts/depth-carousel.js';
</script>
