---
---
<div class="services-wrapper" id="services">
<section class="section services">
    <!-- Intro con blur que desaparece al scroll -->
    <div class="services__intro">
        <div class="services__intro-bg"></div>
        <div class="services__intro-content">
            <span class="section-tag">What We Do</span>
            <h2 class="services__intro-title">More Services</h2>
            <p class="services__intro-text">Full-service construction and remodeling</p>
        </div>
    </div>

    <!-- Gallery de servicios -->
    <div class="services__gallery">
        <article class="service-image-card" style="background-image: url('/img/img57.jpg')">
            <div class="service-image-card__overlay">
                <h3>Flooring</h3>
                <p>Hardwood, tile, laminate, and more</p>
            </div>
        </article>
        <article class="service-image-card" style="background-image: url('/img/img61.jpg')">
            <div class="service-image-card__overlay">
                <h3>Painting</h3>
                <p>Interior <span class="amp">&amp;</span> exterior professional painting</p>
            </div>
        </article>
        <article class="service-image-card" style="background-image: url('/img/img56.jpg')">
            <div class="service-image-card__overlay">
                <h3>Drywall</h3>
                <p>Installation, repair, and finishing</p>
            </div>
        </article>
        <article class="service-image-card" style="background-image: url('/img/img54.jpg')">
            <div class="service-image-card__overlay">
                <h3>Framing</h3>
                <p>Structural framing for new builds</p>
            </div>
        </article>
        <article class="service-image-card" style="background-image: url('/img/img58.jpg')">
            <div class="service-image-card__overlay">
                <h3>Stone</h3>
                <p>Natural and manufactured stone work</p>
            </div>
        </article>
        <article class="service-image-card" style="background-image: url('/img/img55.jpg')">
            <div class="service-image-card__overlay">
                <h3>Pavers</h3>
                <p>Driveways, patios, walkways</p>
            </div>
        </article>
        <article class="service-image-card" style="background-image: url('/img/img59.jpg')">
            <div class="service-image-card__overlay">
                <h3>Fireplaces</h3>
                <p>Installation and remodeling</p>
            </div>
        </article>
        <article class="service-image-card" style="background-image: url('/img/img52.jpg')">
            <div class="service-image-card__overlay">
                <h3>Roofing</h3>
                <p>Repairs, replacements, new installs</p>
            </div>
        </article>
        <article class="service-image-card" style="background-image: url('/img/img50.jpg')">
            <div class="service-image-card__overlay">
                <h3>Remodeling</h3>
                <p>Kitchen, bathroom, full home remodels</p>
            </div>
        </article>
    </div>
</section>
</div>

<script>
import '../scripts/services.js';
</script>
